PORT=4317
HOST=127.0.0.1
# Required before exposing the dashboard outside a local development machine.
ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional Meta WhatsApp Cloud API connection.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Optional public URL used in outgoing WhatsApp messages.
PUBLIC_BASE_URL=http://localhost:4317
